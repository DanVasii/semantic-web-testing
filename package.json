{
  "name": "semantic-web-testing-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "description": "Aplicație desktop pentru testare web semantică end-to-end.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run build:main && npm run renderer:build",
    "build:main": "tsc --project tsconfig.build.json",
    "dev": "npm run build:main && node scripts/dev.mjs",
    "electron:start": "npm run build && electron .",
    "fixture:web": "vite fixtures/web --host 127.0.0.1 --port 4173 --strictPort",
    "fixture:web:build": "vite build fixtures/web --outDir ../../dist/fixture-web --emptyOutDir",
    "fixture:mysql:setup": "node scripts/setup-mysql-fixture.mjs",
    "fixture:mysql:api": "node scripts/mysql-fixture-server.mjs",
    "smoke:recorder": "node scripts/smoke-recorder.mjs",
    "smoke:mysql": "node scripts/smoke-mysql-fixture.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint src --max-warnings 0",
    "renderer:build": "vite build src/renderer --config vite.config.ts --base ./ --outDir ../../dist/renderer --emptyOutDir",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run fixture:web:build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "41.7.1",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "electron@41.7.1": true
  },
  "dependencies": {
    "@types/mailparser": "^3.4.6",
    "imapflow": "^1.5.0",
    "mailparser": "^3.9.14",
    "mysql2": "^3.23.1",
    "nodemailer": "9.0.3",
    "playwright-core": "^1.61.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
