{
  "name": "semantic-web-testing-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aplicație desktop pentru testare web semantică end-to-end.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "verify": "npm run lint && npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
