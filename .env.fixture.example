# Optional SMTP delivery for the local booking fixture.
# Copy to .env.fixture, fill locally, then restart the fixture API.
# An empty host disables email delivery.
SEMANTIC_FIXTURE_SMTP_HOST=
SEMANTIC_FIXTURE_SMTP_PORT=587
SEMANTIC_FIXTURE_SMTP_SECURE=false
SEMANTIC_FIXTURE_SMTP_USER=
SEMANTIC_FIXTURE_SMTP_PASSWORD=
SEMANTIC_FIXTURE_SMTP_FROM=
